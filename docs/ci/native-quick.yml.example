# Reference only. This file is not an active GitHub Actions workflow.
name: Native checks

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: native-checks
  cancel-in-progress: false

jobs:
  native:
    name: Native 1.3.0 types and selfchecks
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      ASTRO_TELEMETRY_DISABLED: "1"
      COREPACK_ENABLE_DOWNLOAD_PROMPT: "0"
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          persist-credentials: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version-file: .node-version
          check-latest: false
          package-manager-cache: false
      - name: Check pinned fixture graph
        run: echo '92b03eee802e42fdf5b8d47f31837ac6d6c9ec012a778a672b9b8a60876705c9  integration/emdash/published-host-1.3.0/pnpm-lock.yaml' | sha256sum --check --strict
      - name: Prepare pinned package manager
        run: |
          corepack enable
          corepack prepare pnpm@11.19.0 --activate
      - name: Install pinned fixture graph
        run: pnpm dev:setup --target native-1.3.0
      - name: Check types and selfchecks
        run: bash scripts/ci-native-quick.sh
