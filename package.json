{
  "name": "shipit-seo-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Development workspace for the Shipit SEO native EmDash plugin.",
  "scripts": {
    "dev:setup": "node ./tooling/plugin-dev/cli.mjs setup",
    "dev:doctor": "node ./tooling/plugin-dev/cli.mjs doctor",
    "dev:admin": "node ./tooling/plugin-dev/cli.mjs dev-admin",
    "dev:engine": "node ./tooling/plugin-dev/cli.mjs dev-engine",
    "dev": "node ./tooling/plugin-dev/cli.mjs dev-admin",
    "verify:quick": "node ./tooling/plugin-dev/cli.mjs quick",
    "verify": "node ./tooling/plugin-dev/cli.mjs verify",
    "dev:report": "node ./tooling/plugin-dev/cli.mjs report",
    "test:tooling": "node --test --test-concurrency=1 tooling/plugin-dev/*.test.mjs packages/emdash-plugin-seo/scripts/packed-artifact.test.mjs scripts/check-translations.test.mjs scripts/check-public-files.test.mjs",
    "check:translations": "node ./scripts/check-translations.mjs",
    "check:public": "node ./scripts/check-public-files.mjs"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.19.0"
}
